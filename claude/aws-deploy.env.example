# SNH deploy config — read by the /deploy skill and scripts/load-config.sh.
#
# This file exists so that CLAUDE.md, READMEs, and committed templates never
# contain account IDs, bucket names, or internal domains. Keep it at mode 600
# and out of every repo.
#
# Nothing here is a credential. AWS access comes from the CLI profile or from
# OIDC in CI; application secrets live in Secrets Manager.

# --- Account ----------------------------------------------------------------
AWS_REGION=us-east-1
AWS_ACCOUNT_ID=

# --- Terraform state --------------------------------------------------------
# Created 2026-08-13 by terraform/bootstrap. Versioned, KMS-encrypted, locked.
# The platform stack is migrated. The 9 project stacks are NOT yet — they still
# use local state on this machine. See references/migrating-from-v1.md.
TF_STATE_BUCKET=
TF_STATE_KMS_KEY_ARN=
TF_STATE_PREFIX=projects

# --- Platform resources -----------------------------------------------------
PLATFORM_VPC_NAME=platform-vpc
PLATFORM_EGRESS_SG_NAME=platform-ecs-egress
PLATFORM_DB_IDENTIFIER=platform-db
ECS_CLUSTER_NAME=default

# Path to the standing platform stack on this machine.
PLATFORM_TF_DIR=$HOME/Development/aws-platform/terraform

# Path to the deploy kit itself.
DEPLOY_KIT_DIR=$HOME/Development/aws-deploy-kit

# --- Domains ----------------------------------------------------------------
HOSTED_ZONE_NAME=
DEFAULT_DOMAIN_PATTERN={service}.apps.example.com

# --- Defaults for new projects ----------------------------------------------
DEFAULT_CPU=512
DEFAULT_MEMORY=1024
DEFAULT_MIN_TASKS=1
DEFAULT_MAX_TASKS=10

# --- GitHub -----------------------------------------------------------------
GITHUB_OWNER=

# --- Seed admin -------------------------------------------------------------
# Every app we build seeds one admin user with these credentials. Deliberately
# the same across environments including production. Seeds must read these from
# env, never hardcode them in a committed file.
SEED_ADMIN_EMAIL=
SEED_ADMIN_PASSWORD=
