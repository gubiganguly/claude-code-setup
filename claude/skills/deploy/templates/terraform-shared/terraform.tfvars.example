# Copy to terraform.tfvars and fill in. NEVER commit terraform.tfvars.

project_name = "myproject"

github_owner  = "SNH-Capital"
github_repo   = "myproject"
github_branch = "main"

# Shared platform PUBLIC subnets (ECS Express tasks run here → internet-facing ALB):
#   cd ~/Development/aws-platform/terraform && terraform output -json public_subnet_ids
platform_public_subnet_ids = ["subnet-aaaa", "subnet-bbbb"]

# Shared `platform-ecs-egress` SG (trusted by platform-rds-sg):
#   cd ~/Development/aws-platform/terraform && terraform output -raw ecs_egress_sg_id
platform_ecs_security_group_id = "sg-XXXXXXXX"

# App secrets — match variables.tf to this app's .env
anthropic_api_key = "sk-ant-..."
