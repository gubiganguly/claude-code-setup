###############################################################################
# config.env.example — copy, fill in, and keep OUT of git.
#
#   mkdir -p ~/.config/aws-deploy-kit
#   cp config.env.example ~/.config/aws-deploy-kit/config.env
#   chmod 600 ~/.config/aws-deploy-kit/config.env
#
# Everything here describes ONE AWS account. Nothing here is a credential: AWS
# access comes from your normal profile or from OIDC in CI, and application
# secrets live in Secrets Manager. These are the account-shaped facts that
# should never be pasted into CLAUDE.md, a README, or a committed template.
#
# Most values come straight from `terraform output deploy_config` in
# terraform/platform, and the bucket from `terraform output` in
# terraform/bootstrap.
###############################################################################

# --- Account ----------------------------------------------------------------

# Region everything is deployed into.
AWS_REGION=us-east-1

# Optional: named AWS CLI profile. Leave unset to use the default credentials.
#AWS_PROFILE=

# Optional but recommended. When set, the deploy skill verifies that the caller
# is actually in this account before touching anything, which is the cheapest
# possible guard against deploying into the wrong company's account.
AWS_ACCOUNT_ID=

# --- Terraform state (from terraform/bootstrap) -----------------------------

TF_STATE_BUCKET=
TF_STATE_KMS_KEY_ARN=

# Prefix for state keys, so several teams can share one bucket cleanly.
TF_STATE_PREFIX=projects

# --- Platform resources (from terraform/platform `deploy_config` output) -----

PLATFORM_VPC_NAME=platform-vpc
PLATFORM_EGRESS_SG_NAME=platform-ecs-egress
PLATFORM_DB_IDENTIFIER=platform-db
ECS_CLUSTER_NAME=default

# --- Domains ----------------------------------------------------------------

# Route 53 public zone for branded app domains, e.g. apps.example.com.
# Leave empty if this account has no zone; apps then use their *.on.aws URLs.
HOSTED_ZONE_NAME=

# Default domain pattern offered when deploying a new app. {service} is
# replaced with the project slug. The deploy skill always asks before using it.
DEFAULT_DOMAIN_PATTERN={service}.${HOSTED_ZONE_NAME}

# --- Defaults for new projects ----------------------------------------------

DEFAULT_CPU=512
DEFAULT_MEMORY=1024
DEFAULT_MIN_TASKS=1
DEFAULT_MAX_TASKS=10

# --- GitHub -----------------------------------------------------------------

# Default org for new repos. Overridden per project when it differs.
GITHUB_OWNER=
